  "author": "Angelo F. Dias Gonçalves <https://angelofdiasg.tech>",
  "type": "commonjs",
  "scripts": {
    "serve": "http-server . -p 8080 -c-1 --silent",
    "test:ui": "cypress open",
    "test:headless": "cypress run",
    "test:ci": "start-server-and-test serve http://localhost:8080 test:headless"
  },
  "devDependencies": {
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.0",
    "cypress": "^15.14.1",
    "cypress-cucumber-preprocessor": "^4.3.1",
    "esbuild": "^0.20.0",
    "http-server": "^14.1.1",
    "openai": "^6.48.0",
    "start-server-and-test": "^2.0.8"
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": false,
    "step_definitions": "cypress/e2e/steps"
  }
