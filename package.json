{
  "name": "qafeally",
  "version": "1.0.0",
  "description": "Auditoria Dinâmica de Acessibilidade WCAG 2.2 com Cypress, BDD (Cucumber) e IA (OpenAI GPT-4o) no GitHub Actions",
  "homepage": "https://github.com/AngeloFDiasGTech/qafeally#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AngeloFDiasGTech/qafeally.git"
